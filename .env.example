# Public base URL used by Telegram buttons and status messages.
PUBLIC_SITE_URL=https://your-domain.example

# Comma-separated ChatGPT account emails allowed to open /admin.
MULTBILIM_ADMIN_EMAILS=owner@example.com

# Telegram values are secrets. Never commit real values.
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
TELEGRAM_ADMIN_IDS=123456789,987654321
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-secret
